{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_ENDURANCE_VERSION}",
	"name": "vip_endurance",
	"description": "[VIP] Endurance: every frame, sets m_flVelocityModifier back to 1.0 for alive VIPs with the togglable 'Endurance' feature (cancels the hurt slowdown). Ported from the Pisex VIP core module VIP_Endurance (vip_endurance). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_endurance",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
